# منفذ الاستماع (Railway يمرّره تلقائيًا عبر PORT)
PORT=3001

# مسار حفظ جلسة واتساب (رقم OTP النظامي الواحد) — لازم يكون على Volume دائم
# في Railway (مثلاً /data/wa-session)، وإلا يطلب مسح QR من جديد بعد كل نشر
WA_SESSION_DIR=./data/wa-session

# مسار أساس لجلسات واتساب الخاصة بكل مجمّع (إشعارات السحب للمولّدين) —
# جلسة فرعية منفصلة لكل collectorId بداخله. نفس ملاحظة Volume أعلاه تنطبق
# (مثلاً /data/notify-sessions)
WA_NOTIFY_SESSIONS_DIR=./data/notify-sessions

# نطاقات مسموح لها بالنداء (CORS) — رابط GitHub Pages الخاص بالموقع
# مثال: https://<github-username>.github.io
ALLOWED_ORIGIN=*

# مفتاح سري بسيط لحماية نقاط الإدارة (status/qr/logout) — ولّد قيمة عشوائية طويلة
ADMIN_TOKEN=change-me
